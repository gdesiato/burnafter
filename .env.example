# Local development only. Copy to .env:  cp .env.example .env

# Message service database
MESSAGE_DB=burnafter
MESSAGE_DB_USER=burnafter
MESSAGE_DB_PASSWORD=change-me

# Audit service database
AUDIT_DB=audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=change-me

# Grafana admin (dashboards are also viewable anonymously, read-only)
GF_SECURITY_ADMIN_PASSWORD=change-me
